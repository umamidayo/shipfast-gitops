# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.

# Required: the repo Argo CD watches. It has to be reachable from inside the
# cluster, so push this repo to GitHub/GitLab/etc. first.
git_repo_url = "https://github.com/your-user/shipfast-gitops.git"
git_revision = "main"

# Private repo? Provide a read-only token (GitHub: fine-grained PAT with
# "Contents: read-only" on this repo).
# git_token = "github_pat_..."

# Deploy CI-built images from GHCR instead of the local registry:
# app_path = "deploy/overlays/ghcr"

# Ports on localhost:
# app_host_port    = 8080
# argocd_host_port = 8081
# registry_port    = 5001

# Pin the Kubernetes version:
# node_image = "kindest/node:v1.33.1"
